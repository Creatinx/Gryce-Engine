<?xml version="1.0" encoding="UTF-8"?>
<!--
  parkour.uif —— 3D 跑酷 HUD 界面声明（仅声明控件树与布局）
  说明：.uif 只负责 UI 声明；玩法逻辑全部放在 game.js（QuickJS）。
  按钮 onClick 仅引用 game.js 中定义的全局函数名：onStart / onRestart。
-->
<Window id="MainRoot" layout="absolute" bgcolor="#00000000">

  <!-- 游戏内持久 HUD（开始后显示） -->
  <Text id="ScoreLabel" text="分数: 0" align="top" margin="0" color="#FFFFFF"
        font-size="34" />
  <Text id="SpeedLabel" text="速度 1.0x" align="right" color="#00E5FF"
        font-size="22" />
  <Text id="TipsLabel"
        text="提示：← / → 或 A / D 切换跑道 · 空格 跳跃　·　R 重新开始"
        align="bottom" color="#FFE082" font-size="20" margin="16" />

  <!-- 开始菜单 -->
  <Panel id="MenuOverlay" align="center" width="360" height="240"
         layout="vertical" padding="24" spacing="14"
         bgcolor="#101018C0" border-radius="14">
    <Text id="MenuTitle" text="Parkour Run" color="#00E5FF" font-size="40" />
    <Text id="MenuDesc" text="3D 跑酷 · 躲避障碍 · 收集能量"
          color="#B0BEC5" font-size="18" />
    <Button id="StartBtn" text="开始游戏" onClick="onStart"
            bgcolor="#3A8DFF" color="#FFFFFF" font-size="24" width="200" height="52" />
    <Text id="MenuTips" text="← → 切换跑道　空格 跳跃"
          color="#FFE082" font-size="16" />
  </Panel>

  <!-- 游戏结束 -->
  <Panel id="GameOverOverlay" align="center" width="360" height="220"
         layout="vertical" padding="24" spacing="16"
         bgcolor="#801010D0" border-radius="14" visible="false">
    <Text id="GameOverTitle" text="游戏结束" color="#FF5252" font-size="40" />
    <Text id="FinalScoreLabel" text="得分: 0" color="#FFFFFF" font-size="24" />
    <Button id="RestartBtn" text="重新开始" onClick="onRestart"
            bgcolor="#FF7043" color="#FFFFFF" font-size="24" width="200" height="52" />
  </Panel>

</Window>