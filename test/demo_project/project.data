{
  "name": "GryceDemo",
  "version": "0.1.0",
  "engine_version": ">=0.1.0",
  "window": {
    "width": 1920,
    "height": 1080,
    "title": "Gryce Renderer"
  },
  "render_api": "vulkan",
  "hdr": true,
  "tone_map_mode": 1,
  "exposure": 1.0,
  "shadow_enabled": true,
  "shadow_map_size": 4096,
  "ambient_r": 0.2,
  "ambient_g": 0.22,
  "ambient_b": 0.26,
  "ibl_intensity": 0.6,

  "default_environment": true,
  "ssao_enabled": true,
  "ssr_enabled": true,
  "ssil_enabled": false,
  "rt_reflection_enabled": true,
  "rt_reflection_resolution_scale": 1.0,
  "ssr_max_steps": 96,
  "pcss_enabled": true,
  "pcss_light_size": 0.3,

  "pcss_max_radius": 8.0,
  "pcss_blocker_scale": 0.5,

  "ssr_max_roughness": 0.6,
  "ssr_thickness": 0.01,
  "ssr_bilateral_filter": 0.5,
  "ssr_env_fallback": 1.0,
  "ssr_resolution_scale": 1.0,
  "main_scene": "res:/scenes/rt_showcase.gesc",
  "rt_reflection_denoise": true,
  "msaa_samples": 4,
  "_comment_antialiasing": "MSAA 只抗几何轮廓；反射边缘与高光细节靠 TAA 时域累积。taa_enabled 打开后细节略软，快速运动物体可能有轻微拖影。",
  "taa_enabled": false,
  "taa_weight": 0.85,
  "super_resolution": "temporal"

}
