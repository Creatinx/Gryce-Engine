{
  "name": "GryceDemo",
  "version": "0.1.0",
  "engine_version": ">=0.1.0",
  "entry_scene": "res:/scenes/main.gesc",
  "window": { "width": 1280, "height": 720, "title": "Gryce Renderer" },
  "render_api": "opengl",
  "hdr": true,
  "tone_map_mode": 1,
  "exposure": 1.0,
  "shadow_enabled": true,
  "shadow_map_size": 2048,
  "ambient_r": 0.2,
  "ambient_g": 0.22,
  "ambient_b": 0.26,
  "ibl_intensity": 1.0,
  "default_environment": true,
  "ssao_enabled": true,
  "ssr_enabled": true,
  "ssil_enabled": false,
  "ssr_max_steps": 64,
  "ssr_max_roughness": 0.6,
  "ssr_thickness": 0.1,
  "ssr_bilateral_filter": 0.5,
  "main_scene": "res:/scenes/main.gesc"
}
