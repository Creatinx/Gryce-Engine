{
  "name": "GryceDemo",
  "version": "0.1.0",
  "engine_version": ">=0.1.0",
  "window": {
    "width": 1920,
    "height": 1080,
    "title": "Gryce Renderer"
  },
  "render_api": "vulkan",
  "hdr": true,
  "tone_map_mode": 1,
  "exposure": 1.0,
  "shadow_enabled": true,
  "shadow_map_size": 4096,
  "ambient_r": 0.03,
  "ambient_g": 0.033,
  "ambient_b": 0.04,
  "ibl_intensity": 0.12,
  "default_environment": true,
  "ssao_enabled": true,
  "ssr_enabled": true,
  "ssil_enabled": false,
  "rt_reflection_enabled": true,
  "rt_reflection_resolution_scale": 1.0,
  "ssr_max_steps": 96,
  "pcss_enabled": true,
  "pcss_light_size": 0.3,
  "pcss_max_radius": 8.0,
  "pcss_blocker_scale": 0.5,
  "ssr_max_roughness": 0.85,
  "ssr_thickness": 0.01,
  "ssr_bilateral_filter": 0.5,
  "ssr_env_fallback": 1.0,
  "ssr_resolution_scale": 1.0,
  "main_scene": "res:/scenes/rt_showcase.gesc",
  "rt_reflection_denoise": true,
  "msaa_samples": 4,
  "_comment_antialiasing": "MSAA \u53ea\u6297\u51e0\u4f55\u8f6e\u5ed3\uff1b\u53cd\u5c04\u8fb9\u7f18\u4e0e\u9ad8\u5149\u7ec6\u8282\u9760 TAA \u65f6\u57df\u7d2f\u79ef\u3002taa_enabled \u6253\u5f00\u540e\u7ec6\u8282\u7565\u8f6f\uff0c\u5feb\u901f\u8fd0\u52a8\u7269\u4f53\u53ef\u80fd\u6709\u8f7b\u5fae\u62d6\u5f71\u3002",
  "taa_enabled": false,
  "taa_weight": 0.85,
  "super_resolution": "temporal",
  "point_shadow_size": 2048
}