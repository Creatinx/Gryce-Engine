# ---- 构建产物 ----
/build/
build_*/
out/
cmake-build-*/   # CLion 默认构建目录名

# ---- 编译器 / 系统文件 ----
*.o
*.obj
*.exe
*.dll
*.a
*.lib
*.so
*.dylib
*.pdb
*.idb

# ---- IDE ----
.idea/
.vscode/
*.code-workspace

# ---- WorkBuddy 本地工作数据（会话记忆等，不入库）----
.workbuddy/

# ---- 运行截图与分析日志 ----
shot_*.png
*.log

# ---- Vulkan SPIR-V 磁盘缓存的内容指纹边车 ----
# .spv 本体随项目提交（作为 shader 源码不可用时的兜底产物），
# .hash 只是"源码内容是否变化"的校验信息，属于本地缓存，不入库。
*.spv.hash

# ---- 系统 ----
Thumbs.db
.DS_Store

# ---- 例外：随仓库分发的第三方预编译静态库 ----
# Amplitude Audio SDK 以预编译静态库形式入库（见根 CMakeLists 说明），
# 需覆盖上面的 *.a 规则。
!third_party/amplitude/lib/*.a

# ---- 例外：Wavefront OBJ 模型资源 ----
# 上面「编译器中间文件」里的 *.obj 本意是忽略 MSVC 编译产物，但它会连带吞掉
# 同后缀的 3D 模型。test/demo_project/models 因此从未入库，克隆后
# scenes/main.gesc 引用的 res:/models/cube.obj 与 quad.obj 全部缺失，
# 场景里一个网格都画不出来。这里对该目录显式放行。
!test/demo_project/models/*.obj
