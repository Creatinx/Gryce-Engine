{
  "name": "Gryce Editor",
  "version": "0.1.0",
  "engine_version": ">=0.1.0",
  "entry_scene": "res:/scenes/main.gesc",
  "main_scene": "res:/scenes/main.gesc",
  "window": { "width": 1600, "height": 900, "title": "Gryce Editor" },
  "render_api": "opengl",
  "hdr": true,
  "tone_map_mode": 1,
  "exposure": 1.0,
  "shadow_enabled": true,
  "shadow_map_size": 2048,
  "ambient_r": 0.2,
  "ambient_g": 0.22,
  "ambient_b": 0.26,
  "ibl_intensity": 0.6,
  "default_environment": true,
  "ssao_enabled": false,
  "ssr_enabled": false,
  "ssil_enabled": false,
  "pcss_enabled": false,
  "start_in_play": false
}
