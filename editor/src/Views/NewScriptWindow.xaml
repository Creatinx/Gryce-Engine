<Window x:Class="GryceEngine.Editor.Views.NewScriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GryceEngine.Editor.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{loc:Loc new_script.title}"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <StackPanel Margin="18,14,18,16">
        <!-- Name -->
        <TextBlock Text="{loc:Loc new_script.name}" FontWeight="SemiBold" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <TextBox x:Name="NameBox" FontSize="12" Padding="8,5"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"/>

        <!-- Base Class -->
        <TextBlock Text="{loc:Loc new_script.base_class}" FontWeight="SemiBold"
                   Margin="0,12,0,4"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <ComboBox x:Name="BaseClassBox" FontSize="12" Padding="6,3"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <!-- Parent Component (present in the scene) -->
        <TextBlock Text="{loc:Loc new_script.parent_component}" FontWeight="SemiBold"
                   Margin="0,12,0,4"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <ComboBox x:Name="ParentComponentBox" FontSize="12" Padding="6,3"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <!-- Template -->
        <TextBlock Text="{loc:Loc new_script.template}" FontWeight="SemiBold"
                   Margin="0,12,0,4"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <ComboBox x:Name="TemplateBox" FontSize="12" Padding="6,3"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <!-- Path + Browse -->
        <TextBlock Text="{loc:Loc new_script.path}" FontWeight="SemiBold"
                   Margin="0,12,0,4"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" FontSize="12" Padding="8,5" Margin="0,0,6,0"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Button Grid.Column="1" x:Name="BrowseButton"
                    Content="{loc:Loc common.browse}"
                    MinWidth="72" MinHeight="30" FontSize="12"
                    Click="OnBrowseClick"/>
        </Grid>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="{loc:Loc new_script.cancel}"
                    MinWidth="88" MinHeight="30" FontSize="12" Margin="0,0,8,0"
                    IsCancel="True"
                    Click="OnCancelClick"/>
            <Button x:Name="CreateButton" Content="{loc:Loc new_script.create}"
                    MinWidth="88" MinHeight="30" FontSize="12"
                    Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True"
                    Click="OnCreateClick"/>
        </StackPanel>
    </StackPanel>
</Window>
