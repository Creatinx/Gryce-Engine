<Window x:Class="GryceEngine.Editor.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GryceEngine.Editor.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{loc:Loc menu.about}"
        Width="440" Height="330"
        MinWidth="380" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,6,0,12">
            <Border Width="72" Height="72" CornerRadius="18" HorizontalAlignment="Center"
                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Gryce Engine" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,12,0,2"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
            <TextBlock Text="{loc:Loc settings.version}" FontSize="11"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="{loc:Loc settings.about_desc}"
                       FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Border Height="1" Margin="0,14"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>
            <TextBlock Text="{loc:Loc settings.tech_stack}" FontSize="11" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="{loc:Loc settings.tech_cpp}" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,2"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="{loc:Loc settings.tech_wpf}" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,2"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="{loc:Loc settings.tech_render}" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,2"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBlock Text="{loc:Loc settings.tech_physics}" FontSize="11"
                       HorizontalAlignment="Center" Margin="0,2"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <Button Grid.Row="2" Content="{loc:Loc common.ok}"
                Style="{StaticResource AccentButtonStyle}"
                MinWidth="96" MinHeight="30" FontSize="12"
                HorizontalAlignment="Center" IsDefault="True" IsCancel="True"
                Click="OnOkClick"/>
    </Grid>
</Window>
