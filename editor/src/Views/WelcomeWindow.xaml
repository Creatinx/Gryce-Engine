<Window x:Class="GryceEngine.Editor.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GryceEngine.Editor.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{loc:Loc welcome.title}"
        Width="560" SizeToContent="Height"
        MinWidth="500" MaxHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" ShowInTaskbar="True"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <StackPanel Margin="28,24,28,20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="Gryce Engine" FontSize="24" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Text="{loc:Loc welcome.subtitle}" FontSize="12" Margin="0,2,0,18"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   TextWrapping="Wrap"/>

        <!-- Primary actions -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Button x:Name="BtnNewProject" Content="{loc:Loc welcome.new_project}"
                    Padding="18,7" Click="OnNewProjectClick"/>
            <Button Content="{loc:Loc welcome.open_project}" Padding="18,7"
                    Margin="10,0,0,0" Click="OnOpenProjectClick"/>
            <Button Content="{loc:Loc welcome.open_example}" Padding="18,7"
                    Margin="10,0,0,0" Click="OnOpenExampleClick"/>
        </StackPanel>

        <!-- Recent projects -->
        <TextBlock Text="{loc:Loc welcome.recent_title}" FontWeight="SemiBold"
                   Margin="0,0,0,6"/>
        <ListBox x:Name="RecentList" Height="200" Padding="2"
                 SelectionChanged="OnRecentSelectionChanged"
                 MouseDoubleClick="OnRecentDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding}" FontSize="12"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="RecentHint" Text="{loc:Loc welcome.no_recent}"
                   FontSize="11" Margin="2,6,0,0"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="BtnOpenRecent" Content="{loc:Loc welcome.open}"
                    Padding="16,6" IsEnabled="False" Click="OnOpenRecentClick"/>
            <Button Content="{loc:Loc welcome.cancel}" Padding="16,6"
                    Margin="10,0,0,0" Click="OnCancelClick"/>
        </StackPanel>
    </StackPanel>
</Window>
