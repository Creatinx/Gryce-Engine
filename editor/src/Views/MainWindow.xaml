<Window x:Class="GryceEngine.Editor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:GryceEngine.Editor.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:views="clr-namespace:GryceEngine.Editor.Views"
        ui:ThemeManager.IsThemeAware="True"
        Title="{Binding Title}"
        Width="1280" Height="800"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="{DynamicResource LayerFillColorDefaultBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveSceneCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewSceneCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteEntityCommand}" />
        <KeyBinding Key="F2" Command="{Binding RenameCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="F" Command="{Binding FocusCommand}" />
        <KeyBinding Key="W" Command="{Binding GizmoTranslateCommand}" />
        <KeyBinding Key="E" Command="{Binding GizmoRotateCommand}" />
        <KeyBinding Key="R" Command="{Binding GizmoScaleCommand}" />
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding TogglePlayModeCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DuplicateCommand}" />
        <KeyBinding Key="X" Modifiers="Ctrl" Command="{Binding CutCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyCommand}" />
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteCommand}" />
    </Window.InputBindings>

    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>    <!-- Title Bar: menu + project name + window buttons -->
            <RowDefinition Height="38"/>    <!-- Playback bar (centered) -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Main Content -->
            <RowDefinition Height="4"/>     <!-- Splitter -->
            <RowDefinition Height="240" MinHeight="140"/> <!-- Bottom Panels -->
            <RowDefinition Height="Auto"/>  <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ================================================================
             Title Bar — menu lives in the caption area (Mica backdrop),
             project name follows the menus, window buttons on the right.
             ================================================================ -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Back / Forward navigation -->
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="2,0,0,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnBack" Style="{StaticResource ToolbarButtonStyle}"
                        Width="30" Height="26" Padding="0"
                        ToolTip="{loc:Loc nav.back}"
                        Command="{Binding BackCommand}"
                        Content="&#xE72B;"/>
                <Button x:Name="BtnForward" Style="{StaticResource ToolbarButtonStyle}"
                        Width="30" Height="26" Padding="0" Margin="2,0,0,0"
                        ToolTip="{loc:Loc nav.forward}"
                        Command="{Binding ForwardCommand}"
                        Content="&#xE72A;"/>
            </StackPanel>

            <Menu Grid.Column="1" x:Name="MainMenu"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  FontSize="11.5" Background="Transparent"
                  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                  VerticalAlignment="Center" Margin="2,0,0,0">
                <Menu.Resources>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="9,3"/>
                        <Setter Property="MinHeight" Value="26"/>
                        <Setter Property="Margin" Value="0,0,1,0"/>
                    </Style>
                </Menu.Resources>
                <MenuItem Header="{loc:Loc menu.file}">
                    <MenuItem Header="{loc:Loc menu.new_scene}" InputGestureText="Ctrl+N"
                              Command="{Binding NewSceneCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Loc menu.save_scene}" InputGestureText="Ctrl+S"
                              Command="{Binding SaveSceneCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Loc menu.load_scene}" Click="OnLoadSceneClick">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="{loc:Loc menu.import_asset}" Click="OnImportAssetClick">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE8B5;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="{loc:Loc menu.settings}" Click="OnSettingsClick">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="{loc:Loc menu.exit}" Click="OnExitClick" InputGestureText="Alt+F4"/>
                </MenuItem>

                <MenuItem Header="{loc:Loc menu.edit}">
                    <MenuItem Header="{loc:Loc menu.undo}" InputGestureText="Ctrl+Z"
                              Command="{Binding UndoCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Loc menu.redo}" InputGestureText="Ctrl+Y"
                              Command="{Binding RedoCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE7A6;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="{loc:Loc menu.cut}" InputGestureText="Ctrl+X"
                              Command="{Binding CutCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Loc menu.copy}" InputGestureText="Ctrl+C"
                              Command="{Binding CopyCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Loc menu.paste}" InputGestureText="Ctrl+V"
                              Command="{Binding PasteCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Loc menu.duplicate}" InputGestureText="Ctrl+D"
                              Command="{Binding DuplicateCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="{loc:Loc menu.create_entity}" Click="OnCreateEntityClick">
                        <MenuItem.Icon>
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{loc:Loc menu.delete}" InputGestureText="Del"
                              Command="{Binding DeleteEntityCommand}"/>
                    <Separator/>
                    <MenuItem Header="{loc:Loc menu.rename}" InputGestureText="F2"
                              Command="{Binding RenameCommand}"/>
                    <MenuItem Header="{loc:Loc menu.focus}" InputGestureText="F"
                              Command="{Binding FocusCommand}"/>
                </MenuItem>

                <MenuItem Header="{loc:Loc menu.view}">
                    <MenuItem Header="{loc:Loc menu.refresh}" InputGestureText="F5"
                              Click="OnRefreshViewClick"/>
                </MenuItem>

                <MenuItem Header="{loc:Loc menu.help}">
                    <MenuItem Header="{loc:Loc menu.about}" Click="OnAboutClick"/>
                </MenuItem>
            </Menu>

            <!-- Project name chip (rounded background) after the menus -->
            <Border Grid.Column="2"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,3"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    MaxWidth="320">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Margin="0,0,6,0"/>
                    <TextBlock x:Name="ProjectNameText"
                               Text="{Binding SceneName}"
                               FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- Window buttons -->
            <StackPanel Grid.Column="4" Orientation="Horizontal"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButtonStyle}"
                        Content="&#xE921;" Click="OnMinimizeClick"/>
                <Button x:Name="BtnMaximize" Style="{StaticResource CaptionButtonStyle}"
                        Content="&#xE922;" Click="OnMaximizeClick"/>
                <Button x:Name="BtnClose" Style="{StaticResource CaptionButtonStyle}"
                        Content="&#xE8BB;" Click="OnCloseClick"/>
            </StackPanel>
        </Grid>

        <!-- ================================================================
             Playback Bar — centered below the title bar
             ================================================================ -->
        <Border Grid.Row="1"
                Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnPlay"
                        Style="{StaticResource PlayButtonStyle}"
                        AutomationProperties.Name="PlayButton"
                        ToolTip="{loc:Loc toolbar.play}"
                        Content="&#xE768;"
                        Click="OnPlayClick"/>
                <Button x:Name="BtnPause"
                        Style="{StaticResource ToolbarButtonStyle}"
                        AutomationProperties.Name="PauseButton"
                        ToolTip="{loc:Loc toolbar.pause}"
                        Content="&#xE769;"
                        Click="OnPauseClick"/>
                <Button x:Name="BtnStop"
                        Style="{StaticResource ToolbarButtonStyle}"
                        AutomationProperties.Name="StopButton"
                        ToolTip="{loc:Loc toolbar.stop}"
                        Content="&#xE71A;"
                        Click="OnStopClick"/>
                <Border Style="{StaticResource VerticalSeparatorStyle}" Margin="10,3"/>
                <TextBlock x:Name="PlaybackStateText" FontSize="10.5"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <views:ToolbarView Grid.Row="2" DataContext="{Binding}"/>

        <!-- ================================================================
             Main Work Area — Hierarchy (Left) | Viewport (Center) | Inspector (Right)
             ================================================================ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="150"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="280" MinWidth="180"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <views:HierarchyView/>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="2"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                <views:ViewportView/>
            </Border>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Column="4"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <views:InspectorView/>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="4" Height="4" HorizontalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"/>

        <!-- ================================================================
             Bottom Panels — Project | Console | Animation
             ================================================================ -->
        <Border Grid.Row="5"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <TabControl x:Name="BottomTabs" BorderThickness="0" Background="Transparent"
                        Padding="0,0,0,0">
                <TabItem Header="{loc:Loc panel.project}">
                    <views:ProjectView/>
                </TabItem>
                <TabItem Header="{loc:Loc panel.console}">
                    <views:ConsoleView/>
                </TabItem>
                <TabItem Header="{loc:Loc panel.animation}">
                    <views:AnimationPanelView/>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ================================================================
             Status Bar
             ================================================================ -->
        <Border Grid.Row="6"
                Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FF8CFF8C"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Background" Value="#FFCCAA00"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <Border Style="{StaticResource VerticalSeparatorStyle}" Margin="8,2"/>
                    <TextBlock FontSize="10.5"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center">
                        <Run Text="{loc:Loc status.entities}"/>
                        <Run Text=": "/>
                        <Run Text="{Binding EntityCount, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="1" FontSize="10.5"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Text="{Binding GizmoModeLabel}"
                           Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}"/>

                <TextBlock Grid.Column="3" FontSize="10"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"
                           FontFamily="Consolas">
                    GryceEngine v0.1.0
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
