<UserControl x:Class="GryceEngine.Editor.Views.ProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GryceEngine.Editor.Markup"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Panel Header ══ -->
        <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc panel.project}"
                           Style="{StaticResource PanelHeaderTextStyle}"/>
                <TextBlock Grid.Column="1" Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets"
                           FontSize="9" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="8,0,3,0"/>
                <TextBlock Grid.Column="2" x:Name="PathLabel" Text="Assets"
                           FontSize="10.5" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                    <TextBlock x:Name="StatusText" FontSize="10"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="BtnUp" Width="24" Height="24"
                            ToolTip="{loc:Loc project.up}" Padding="0" Margin="0,0,2,0"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="OnUpClick">
                        <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnNewFolder" Width="24" Height="24"
                            ToolTip="{loc:Loc project.new_folder}" Padding="0" Margin="0,0,2,0"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="OnNewFolderClick">
                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                    <Button x:Name="BtnRefresh" Width="24" Height="24"
                            ToolTip="{loc:Loc project.refresh}" Padding="0"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Click="OnRefreshClick">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Search Bar ══ -->
        <Border Grid.Row="1"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="6,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" Margin="4,0,4,0"/>
                <TextBox Grid.Column="1" x:Name="SearchBox"
                         FontSize="11" BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                         VerticalAlignment="Center"
                         TextChanged="OnSearchTextChanged"/>
                <Button Grid.Column="2" x:Name="ClearSearchBtn"
                        Width="20" Height="20" FontSize="10"
                        Content="&#xE711;" FontFamily="Segoe MDL2 Assets"
                        Visibility="Collapsed" Padding="0"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Click="OnClearSearchClick"/>
                <TextBlock Grid.Column="3" x:Name="ItemCount" Text=""
                           FontSize="10" Margin="6,0,4,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ Two-Pane Layout ══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" MinWidth="100"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Folder Tree -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <TreeView x:Name="FolderTree" BorderThickness="0"
                          Background="Transparent"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          SelectedItemChanged="OnFolderTreeSelectionChanged"
                          FontSize="11"
                          Padding="0,2,0,6"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem"
                               BasedOn="{StaticResource CompactTreeItemStyle}">
                            <Setter Property="IsExpanded" Value="False"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- Right: File Grid -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- File list -->
                <ListBox Grid.Row="0" x:Name="FileListBox"
                         BorderThickness="0" Background="Transparent"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         SelectionMode="Single"
                         PreviewMouseMove="OnFileListPreviewMouseMove"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False"
                         SelectionChanged="OnFileSelectionChanged"
                         MouseDoubleClick="OnFileDoubleClick">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Loc project.refresh}" Click="OnRefreshClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc project.new_folder}" Click="OnNewFolderClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc project.new_scene}" Click="OnNewSceneClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc project.new_material}" Click="OnNewMaterialClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE791;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc project.new_script}" Click="OnNewScriptClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Style="{StaticResource ContextMenuSeparatorStyle}"/>
                                <MenuItem Header="{loc:Loc common.rename}" Click="OnRenameClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE8AC;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc common.delete}" Click="OnDeleteClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Style="{StaticResource ContextMenuSeparatorStyle}"/>
                                <MenuItem Header="{loc:Loc project.copy_path}" Click="OnCopyPathClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{loc:Loc project.open_in_explorer}" Click="OnOpenInExplorerClick">
                                    <MenuItem.Icon>
                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="80" Height="76" Margin="2" Padding="4"
                                        Background="Transparent" CornerRadius="5"
                                        ToolTip="{Binding Name}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=IsSelected}"
                                                             Value="True">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource AccentFillColorSecondaryBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- Solid icon tile covers the item background -->
                                        <Border Width="46" Height="46" CornerRadius="8"
                                                HorizontalAlignment="Center"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding Icon}"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="24"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding IconColor}"/>
                                        </Border>
                                        <!-- File name -->
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="9.5"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextWrapping="NoWrap"
                                                   MaxWidth="72"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty state -->
                <Border Grid.Row="0"
                        x:Name="EmptyState"
                        Visibility="Collapsed"
                        Background="Transparent">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="36" Opacity="0.12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc project.empty}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Opacity="0.35" HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

    </Grid>
</UserControl>
