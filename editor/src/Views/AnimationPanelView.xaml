<UserControl x:Class="GryceEngine.Editor.Views.AnimationPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GryceEngine.Editor.Markup"
             x:Name="AnimationControl">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Loc panel.animation}"
                           Style="{StaticResource PanelHeaderTextStyle}"/>
                <TextBlock x:Name="StatusText" Grid.Column="1"
                           FontSize="10.5"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10,6">
            <!-- 未选中动画实体时的提示 -->
            <TextBlock x:Name="NoAnimatorText"
                       Text="{loc:Loc animation.no_animator}"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center"/>

            <!-- 动画控制条 -->
            <Grid x:Name="Controls" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 第一行：Clip + 播放控制 -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{loc:Loc animation.clip}"
                           FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,6,0"/>
                <ComboBox x:Name="ClipCombo" Grid.Row="0" Grid.Column="1"
                          FontSize="11" Padding="6,3" MinWidth="160"
                          SelectionChanged="OnClipSelectionChanged"/>
                <Button x:Name="PlayPauseButton" Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Width="30" Height="24" Margin="6,0,2,0"
                        ToolTip="{loc:Loc animation.play}"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE768;"
                        Click="OnPlayPauseClick"/>
                <Button x:Name="StopButton" Grid.Row="0" Grid.Column="3"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Width="30" Height="24"
                        ToolTip="{loc:Loc animation.stop}"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE71A;"
                        Click="OnStopClick"/>

                <!-- 第二行：Loop + Speed -->
                <CheckBox x:Name="LoopCheck" Grid.Row="1" Grid.Column="0"
                          Content="{loc:Loc animation.loop}"
                          FontSize="11" VerticalAlignment="Center"
                          Margin="0,6,16,0"
                          Checked="OnLoopChanged" Unchecked="OnLoopChanged"/>
                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc animation.speed}"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Slider x:Name="SpeedSlider" Grid.Column="1"
                            Minimum="0" Maximum="4" TickFrequency="0.1"
                            IsSnapToTickEnabled="False"
                            Margin="8,0" VerticalAlignment="Center"
                            ValueChanged="OnSpeedChanged"/>
                    <TextBlock x:Name="SpeedLabel" Grid.Column="2"
                               Text="1.00x" FontSize="10.5" FontFamily="Consolas"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </Grid>

                <!-- 第三行：时间轴 -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{loc:Loc animation.time}"
                           FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,8,6,0"/>
                <Slider x:Name="TimeSlider" Grid.Row="2" Grid.Column="1"
                        Minimum="0" Maximum="10"
                        Margin="8,8,8,0" VerticalAlignment="Center"
                        ValueChanged="OnTimeChanged"/>
                <TextBlock x:Name="TimeLabel" Grid.Row="2" Grid.Column="2"
                           Text="0.00s / 0.00s" FontSize="10.5" FontFamily="Consolas"
                           VerticalAlignment="Center" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
