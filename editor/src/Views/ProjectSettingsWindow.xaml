<Window x:Class="GryceEngine.Editor.Views.ProjectSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Project Settings"
        Width="620" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 滚动式布局：单页滚动，分区标题 + 控件 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      Padding="16,12,16,8">
            <StackPanel>

                <!-- ══ 渲染 ══ -->
                <TextBlock Text="渲染 (Rendering)" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="渲染后端 (Render API)" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding RenderApis}"
                              SelectedIndex="{Binding RenderApiIndex}"
                              FontSize="12" Height="26" Width="220" HorizontalAlignment="Left"/>
                </Grid>
                <TextBlock Text="后端切换在编辑器重启后生效。" FontSize="10.5"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="140,0,0,10"/>

                <CheckBox IsChecked="{Binding Hdr}" FontSize="12" Margin="0,6"
                          Content="HDR (高动态范围)" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="色调映射 (Tone Map)" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding ToneMapModes}"
                              SelectedIndex="{Binding ToneMapIndex}"
                              FontSize="12" Height="26" Width="220" HorizontalAlignment="Left"/>
                </Grid>

                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="曝光 (Exposure)" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Exposure, UpdateSourceTrigger=LostFocus}"
                             FontSize="12" Height="24"/>
                </Grid>

                <CheckBox IsChecked="{Binding ShadowEnabled}" FontSize="12" Margin="0,6"
                          Content="阴影 (Shadow)" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="阴影贴图尺寸" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding ShadowMapSize, UpdateSourceTrigger=LostFocus}"
                             FontSize="12" Height="24"/>
                </Grid>
                <TextBlock Text="阴影贴图尺寸在编辑器重启后生效。" FontSize="10.5"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Margin="140,0,0,6"/>

                <!-- ══ 环境 ══ -->
                <TextBlock Text="环境 (Environment)" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,18,0,10"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="环境光 (Ambient RGB)" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding AmbientR, UpdateSourceTrigger=LostFocus}"
                             FontSize="12" Height="24" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="2" Text="{Binding AmbientG, UpdateSourceTrigger=LostFocus}"
                             FontSize="12" Height="24" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="3" Text="{Binding AmbientB, UpdateSourceTrigger=LostFocus}"
                             FontSize="12" Height="24"/>
                </Grid>

                <Grid Margin="0,8,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="IBL 强度" FontSize="12"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding IblIntensity, UpdateSourceTrigger=LostFocus}"
                             FontSize="12" Height="24"/>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <Border Grid.Row="1"
                Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="恢复默认" Command="{Binding ResetCommand}"
                        FontSize="11" Padding="8,4"/>
                <Button Grid.Column="2" Content="取消" Command="{Binding CancelCommand}"
                        FontSize="12" Padding="16,6" Margin="0,0,8,0"/>
                <Button Grid.Column="3" Style="{StaticResource AccentButtonStyle}"
                        Content="应用" Command="{Binding ApplyCommand}"
                        FontSize="12" Padding="16,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
