<Window x:Class="GryceEngine.Editor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GryceEngine.Editor.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:vm="clr-namespace:GryceEngine.Editor.ViewModels"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{loc:Loc settings.title}"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 滚动式设置：单页滚动，分区标题 + 控件（不用选项卡） -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      Padding="16,12,16,8">
            <StackPanel>

                <!-- ══ 外观 ══ -->
                <TextBlock Text="{loc:Loc settings.appearance}" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,10"/>
                <StackPanel Margin="0,0,0,4">
                    <RadioButton IsChecked="{Binding IsDarkTheme}" GroupName="Theme" Margin="0,4"
                                 Content="{loc:Loc settings.dark_theme}" FontSize="12"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <RadioButton IsChecked="{Binding IsLightTheme}" GroupName="Theme" Margin="0,4"
                                 Content="{loc:Loc settings.light_theme}" FontSize="12"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <CheckBox IsChecked="{Binding MicaBackdrop}" Margin="0,8,0,0" FontSize="12"
                              Content="{loc:Loc settings.mica}"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <!-- ══ 语言 ══ -->
                <TextBlock Text="{loc:Loc settings.language}" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,18,0,10"/>
                <ComboBox ItemsSource="{Binding Languages}"
                          SelectedIndex="{Binding SelectedLanguageIndex}"
                          FontSize="12" Height="28" Width="260" HorizontalAlignment="Left"
                          VerticalContentAlignment="Center" Padding="6,2"/>

                <!-- ══ 编辑器 ══ -->
                <TextBlock Text="{loc:Loc settings.general}" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,18,0,10"/>
                <CheckBox IsChecked="{Binding VSyncEnabled}" FontSize="12" Margin="0,4"
                          Content="{loc:Loc settings.vsync}"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Grid Margin="0,10,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc settings.autosave}"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center" FontSize="12"/>
                    <TextBox Grid.Column="1" Text="{Binding AutoSaveInterval, UpdateSourceTrigger=LostFocus}"
                             FontSize="12" Margin="8,0,0,0" Width="60" Height="24" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{loc:Loc settings.autosave_disabled}" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="4,0,0,0"/>
                </Grid>

                <!-- ══ 视口 ══ -->
                <TextBlock Text="{loc:Loc settings.viewport}" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,18,0,10"/>
                <StackPanel>
                    <CheckBox IsChecked="{Binding ShowGrid}" FontSize="12" Margin="0,4"
                              Content="{loc:Loc settings.show_grid}"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <CheckBox IsChecked="{Binding ShowGizmos}" FontSize="12" Margin="0,4"
                              Content="{loc:Loc settings.show_gizmos}"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <CheckBox IsChecked="{Binding ShowStats}" FontSize="12" Margin="0,4"
                              Content="{loc:Loc settings.show_stats}"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>

                <!-- ══ 关于 ══ -->
                <TextBlock Text="{loc:Loc settings.about}" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,18,0,10"/>
                <TextBlock Text="Gryce Engine Editor" FontWeight="Bold" FontSize="16"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="{loc:Loc settings.version}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="{loc:Loc settings.about_desc}" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding WorkspaceText}" FontSize="11"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,10,0,0"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom buttons -->
        <Border Grid.Row="1"
                Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="{loc:Loc settings.reset_defaults}"
                        Command="{Binding ResetCommand}"
                        FontSize="11" Padding="8,4"/>

                <Button Grid.Column="2"
                        Content="{loc:Loc settings.cancel}"
                        Command="{Binding CancelCommand}"
                        FontSize="12" Padding="16,6" Margin="0,0,8,0"/>

                <Button Grid.Column="3"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="{loc:Loc settings.apply}"
                        Command="{Binding ApplyCommand}"
                        FontSize="12" Padding="16,6"/>
            </Grid>
        </Border>
    </Grid>
</Window>
