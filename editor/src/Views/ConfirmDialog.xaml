<Window x:Class="GryceEngine.Editor.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GryceEngine.Editor.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{loc:Loc confirm.delete_title}"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <StackPanel Margin="20,16">
        <!-- Message -->
        <TextBlock x:Name="MessageText"
                   TextWrapping="Wrap" FontSize="12.5"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="{loc:Loc common.cancel}"
                    MinWidth="88" MinHeight="30" FontSize="12" Margin="0,0,8,0"
                    IsCancel="True" Click="OnCancelClick"/>
            <Button x:Name="ConfirmButton" Content="{loc:Loc common.delete}"
                    MinWidth="88" MinHeight="30" FontSize="12"
                    Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True" Click="OnConfirmClick"/>
        </StackPanel>
    </StackPanel>
</Window>
