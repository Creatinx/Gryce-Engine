<UserControl x:Class="GryceEngine.Editor.Views.ViewportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:GryceEngine.Editor.Markup"
             xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Focusable="True"
             PreviewKeyDown="OnPreviewKeyDown"
             PreviewKeyUp="OnPreviewKeyUp">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Viewport Tabs (Scene / Game) ══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Scene / Game Tabs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <ToggleButton x:Name="TabScene"
                                  IsChecked="True"
                                  Style="{StaticResource ViewportTabStyle}"
                                  Click="OnSceneTabClick">
                        <ToggleButton.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Loc viewport.release_3d_memory}" Click="OnRelease3DSceneClick"/>
                            </ContextMenu>
                        </ToggleButton.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Loc viewport.tab_3d}"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="Tab2D"
                                  IsChecked="False"
                                  Style="{StaticResource ViewportTabStyle}"
                                  Click="On2DTabClick">
                        <ToggleButton.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{loc:Loc viewport.release_2d_memory}" Click="OnRelease2DSceneClick"/>
                            </ContextMenu>
                        </ToggleButton.ContextMenu>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Loc viewport.tab_2d}"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="TabScript"
                                  IsChecked="False"
                                  Style="{StaticResource ViewportTabStyle}"
                                  Click="OnScriptTabClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Loc viewport.tab_script}"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="TabGame"
                                  IsChecked="False"
                                  Style="{StaticResource ViewportTabStyle}"
                                  Click="OnGameTabClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Loc viewport.game}"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <!-- Right: Display Mode + Resolution -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            x:Name="ViewportToolsRight"
                            VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button x:Name="BtnDisplayMode"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Width="Auto" MinWidth="28"
                            FontSize="10.5" FontFamily="Segoe UI"
                            ToolTip="{loc:Loc viewport.display_mode}"
                            Padding="6,0"
                            Content="{loc:Loc viewport.shaded}"
                            Click="OnDisplayModeClick"/>
                    <Border Style="{StaticResource VerticalSeparatorStyle}" Margin="2,2"/>
                    <TextBlock x:Name="ViewportResolution" Text=""
                               FontSize="10" FontFamily="Consolas"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" Margin="4,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Viewport Render Surface ══ -->
        <Border Grid.Row="1"
                x:Name="ViewportBorder"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                ClipToBounds="True">
            <Grid>
                <!-- Main render host (HWND child window) -->
                <ContentControl x:Name="HostContainer"/>

                <!-- Script editor (Monaco via WebView2) replaces the render
                     surface while the Script tab is active -->
                <wv2:WebView2 x:Name="ScriptWebView"
                              Visibility="Collapsed"
                              DefaultBackgroundColor="#FF1E1E1E"/>

                <!-- Gizmo overlay (top-right) -->
                <Border x:Name="GizmoOverlay"
                        IsHitTestVisible="False"
                        VerticalAlignment="Top" HorizontalAlignment="Right"
                        Margin="8" Padding="8,4" CornerRadius="4"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        Opacity="0.9">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="GizmoIcon" Text="&#xE8AB;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="#FF8CFF8C"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="GizmoLabel" Text="{Binding GizmoMode}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF8CFF8C"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Playing overlay (top-left) -->
                <Border x:Name="ViewportOverlay"
                        IsHitTestVisible="False"
                        VerticalAlignment="Top" HorizontalAlignment="Left"
                        Margin="8" CornerRadius="4"
                        Background="#CC000000" Padding="8,3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" Margin="0,0,4,0"
                                   Foreground="#FF8CFF8C"/>
                        <TextBlock Text="{loc:Loc viewport.playing}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#FF8CFF8C" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- No renderer / loading state -->
                <Border x:Name="NoRendererMessage"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        Visibility="Visible">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7C1;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="56" Opacity="0.12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Gryce Engine"
                                   FontSize="22" FontWeight="Light"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Opacity="0.2" HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                        <TextBlock x:Name="InitStatusText" Text="Initializing renderer..."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   Opacity="0.12" HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ Viewport Info Bar ══ -->
        <Border Grid.Row="2"
                x:Name="ViewportInfoBar"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="GizmoInfo"
                           Text="{loc:Loc viewport.scene_view}"
                           FontSize="10"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="2" x:Name="FpsCounter"
                           Text="-- FPS"
                           FontSize="10" FontFamily="Consolas"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                <TextBlock Grid.Column="3" FontSize="10"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"
                           FontFamily="Consolas">
                    <Run Text="{loc:Loc viewport.renderer}"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
