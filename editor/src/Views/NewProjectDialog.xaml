<Window x:Class="GryceEngine.Editor.Views.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GryceEngine.Editor.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{loc:Loc new_project.title}"
        Width="560" SizeToContent="Height"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 项目名称 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc new_project.name}"
                       FontSize="12.5" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBox Grid.Column="1" x:Name="NameBox" FontSize="12" Padding="6,4"
                     TextChanged="OnNameChanged"/>
        </Grid>

        <!-- 项目路径（父目录） -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc new_project.parent_dir}"
                       FontSize="12.5" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <TextBox Grid.Column="1" x:Name="ParentDirBox" FontSize="12" Padding="6,4"
                     VerticalContentAlignment="Center"/>
            <Button Grid.Column="2" Content="{loc:Loc common.browse}"
                    MinWidth="72" MinHeight="30" FontSize="12"
                    Margin="8,0,0,0" Click="OnBrowseClick"/>
        </Grid>

        <!-- 模板类型（2D / 3D） -->
        <Grid Grid.Row="2" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc new_project.template}"
                       FontSize="12.5" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton x:Name="Template3D" GroupName="Template" IsChecked="True"
                             Content="{loc:Loc new_project.template_3d}" FontSize="12"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             VerticalAlignment="Center" Margin="0,0,20,0"/>
                <RadioButton x:Name="Template2D" GroupName="Template"
                             Content="{loc:Loc new_project.template_2d}" FontSize="12"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 目标目录提示 + 状态/错误 -->
        <TextBlock Grid.Row="3" x:Name="TargetText" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   Margin="110,2,0,10"/>
        <TextBlock Grid.Row="3" x:Name="StatusText" FontSize="11.5" TextWrapping="Wrap"
                   Foreground="#FFE57373" Margin="110,0,0,10"
                   Visibility="Collapsed"/>

        <!-- 操作 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="{loc:Loc common.cancel}"
                    MinWidth="88" MinHeight="30" FontSize="12" Margin="0,0,8,0"
                    IsCancel="True" Click="OnCancelClick"/>
            <Button x:Name="CreateButton" Content="{loc:Loc new_project.create}"
                    MinWidth="96" MinHeight="30" FontSize="12"
                    Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True" Click="OnCreateClick"/>
        </StackPanel>
    </Grid>
</Window>