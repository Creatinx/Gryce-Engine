<Window x:Class="GryceEngine.Editor.Views.ScriptEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GryceEngine.Editor.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="Lua Script"
        Width="820" Height="600"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnUndo" Width="28" Height="28" Padding="0"
                            ToolTip="Undo (Ctrl+Z)" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Margin="0,0,4,0" Click="OnUndoClick">
                        <TextBlock Text="&#xE7A7;"/>
                    </Button>
                    <Button x:Name="BtnRedo" Width="28" Height="28" Padding="0"
                            ToolTip="Redo (Ctrl+Y)" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            Margin="0,0,8,0" Click="OnRedoClick">
                        <TextBlock Text="&#xE7A6;"/>
                    </Button>
                    <Button Content="{loc:Loc script_editor.save}"
                            MinWidth="72" MinHeight="28" FontSize="12"
                            Margin="0,0,8,0" Click="OnSaveClick"/>
                    <Button Content="{loc:Loc script_editor.reload}"
                            MinWidth="72" MinHeight="28" FontSize="12"
                            Click="OnReloadClick"/>
                </StackPanel>
                <TextBlock Grid.Column="3" x:Name="StatusText" FontSize="10.5"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Editor: line numbers + highlighted code -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="LineScroll" Grid.Column="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden"
                          IsHitTestVisible="False"
                          Background="{DynamicResource LayerFillColorAltBrush}">
                <TextBlock x:Name="LineNumbers" FontFamily="Consolas" FontSize="13"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           Padding="8,4,6,4"
                           TextAlignment="Right"/>
            </ScrollViewer>
            <Border Grid.Column="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1,0,0,0">
                <RichTextBox x:Name="EditorBox" FontFamily="Consolas" FontSize="13"
                             BorderThickness="0" Padding="8,4"
                             AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             TextChanged="OnEditorTextChanged"
                             PreviewKeyDown="OnEditorPreviewKeyDown"/>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource LayerFillColorAltBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock x:Name="PathText" FontSize="10.5"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
