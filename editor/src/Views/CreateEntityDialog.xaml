<Window x:Class="GryceEngine.Editor.Views.CreateEntityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:loc="clr-namespace:GryceEngine.Editor.Markup"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{loc:Loc create_entity.dialog_title}"
        Width="760" Height="540"
        MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Entity Name ══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{loc:Loc create_entity.name_field}"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,12,0"/>
            <TextBox x:Name="NameBox" Grid.Column="1"
                     FontSize="12" Padding="8,5"/>
        </Grid>

        <!-- ══ Recent (left) | Search + Types + Description (right) ══ -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" MinWidth="140"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Recent -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="{loc:Loc create_entity.recent}"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="2,0,0,6"/>
                    <ListBox x:Name="RecentList"
                             BorderThickness="0" Background="Transparent"
                             FontSize="12"
                             SelectionChanged="OnRecentSelectionChanged"/>
                </DockPanel>
            </Border>

            <!-- Right column -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" Margin="4,0,8,0"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1"
                             FontSize="12" Padding="8,5"
                             KeyDown="OnSearchKeyDown"
                             TextChanged="OnSearchTextChanged"/>
                </Grid>

                <!-- Type list -->
                <ListBox x:Name="TypeList" Grid.Row="2"
                         BorderThickness="0" Background="Transparent"
                         FontSize="12"
                         VirtualizingPanel.IsVirtualizing="False"
                         VirtualizingPanel.VirtualizationMode="Standard"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="OnTypeListDoubleClick"
                         SelectionChanged="OnTypeSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="8,4"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Border Grid.Column="1" Padding="6,1" CornerRadius="3"
                                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        Visibility="{Binding CategoryVisibility}">
                                    <TextBlock Text="{Binding Category}"
                                               FontSize="9.5"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Description -->
                <Border Grid.Row="4" Padding="10,8" CornerRadius="6"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" MinHeight="58">
                    <TextBlock x:Name="DescriptionText"
                               Text="{loc:Loc create_entity.no_selection}"
                               FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Border>
            </Grid>
        </Grid>

        <!-- ══ Buttons ══ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{loc:Loc create_entity.cancel}"
                    MinWidth="92" MinHeight="30" FontSize="12"
                    Margin="0,0,8,0" Click="OnCancelClick"/>
            <Button Content="{loc:Loc create_entity.create}"
                    MinWidth="92" MinHeight="30" FontSize="12"
                    Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True" Click="OnCreateClick"/>
        </StackPanel>
    </Grid>
</Window>
