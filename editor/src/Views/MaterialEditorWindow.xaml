<Window x:Class="GryceEngine.Editor.Views.MaterialEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:loc="clr-namespace:GryceEngine.Editor.Markup"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{loc:Loc material_editor.title}"
        Width="560" Height="620"
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText"
                   FontSize="15" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                   Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ══ 表面参数 ══ -->
                <TextBlock Text="{loc:Loc material_editor.surface_inputs}"
                           Style="{StaticResource InspectorSectionHeaderStyle}"/>
                <Grid Margin="0,4,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="{loc:Loc material_editor.albedo}"
                               Style="{StaticResource PropertyLabelStyle}"/>
                    <TextBox x:Name="AlbedoR" Grid.Row="1" Grid.Column="0" Margin="0,2,3,2"
                             Style="{StaticResource PropertyTextBoxStyle}" Text="1"
                             TextChanged="OnAlbedoChanged"/>
                    <TextBox x:Name="AlbedoG" Grid.Row="1" Grid.Column="1" Margin="0,2,3,2"
                             Style="{StaticResource PropertyTextBoxStyle}" Text="1"
                             TextChanged="OnAlbedoChanged"/>
                    <TextBox x:Name="AlbedoB" Grid.Row="1" Grid.Column="2" Margin="0,2,3,2"
                             Style="{StaticResource PropertyTextBoxStyle}" Text="1"
                             TextChanged="OnAlbedoChanged"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="RGB" FontSize="10"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc material_editor.roughness}"
                               Style="{StaticResource PropertyLabelStyle}" Margin="0,8,0,0"/>
                    <TextBox x:Name="RoughnessBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                             Margin="0,8,3,0" Style="{StaticResource PropertyTextBoxStyle}" Text="0.5"
                             TextChanged="OnFloatChanged"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc material_editor.metallic}"
                               Style="{StaticResource PropertyLabelStyle}" Margin="0,8,0,0"/>
                    <TextBox x:Name="MetallicBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                             Margin="0,8,3,0" Style="{StaticResource PropertyTextBoxStyle}" Text="0"
                             TextChanged="OnFloatChanged"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc material_editor.opacity}"
                               Style="{StaticResource PropertyLabelStyle}" Margin="0,8,0,0"/>
                    <TextBox x:Name="OpacityBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                             Margin="0,8,3,0" Style="{StaticResource PropertyTextBoxStyle}" Text="1"
                             TextChanged="OnFloatChanged"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc material_editor.ao}"
                               Style="{StaticResource PropertyLabelStyle}" Margin="0,8,0,0"/>
                    <TextBox x:Name="AoBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                             Margin="0,8,3,0" Style="{StaticResource PropertyTextBoxStyle}" Text="0"
                             TextChanged="OnFloatChanged"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="{loc:Loc material_editor.emissive}"
                               Style="{StaticResource PropertyLabelStyle}" Margin="0,8,0,0"/>
                    <TextBox x:Name="EmissiveR" Grid.Row="7" Grid.Column="0" Margin="0,2,3,2"
                             Style="{StaticResource PropertyTextBoxStyle}" Text="0"
                             TextChanged="OnEmissiveChanged"/>
                    <TextBox x:Name="EmissiveG" Grid.Row="7" Grid.Column="1" Margin="0,2,3,2"
                             Style="{StaticResource PropertyTextBoxStyle}" Text="0"
                             TextChanged="OnEmissiveChanged"/>
                    <TextBox x:Name="EmissiveB" Grid.Row="7" Grid.Column="2" Margin="0,2,3,2"
                             Style="{StaticResource PropertyTextBoxStyle}" Text="0"
                             TextChanged="OnEmissiveChanged"/>
                    <TextBlock Grid.Row="7" Grid.Column="3" Text="RGB" FontSize="10"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{loc:Loc material_editor.uv_scale}"
                               Style="{StaticResource PropertyLabelStyle}" Margin="0,8,0,0"/>
                    <TextBox x:Name="UvScaleU" Grid.Row="8" Grid.Column="1" Margin="0,8,3,2"
                             Style="{StaticResource PropertyTextBoxStyle}" Text="1"
                             TextChanged="OnUvChanged"/>
                    <TextBox x:Name="UvScaleV" Grid.Row="8" Grid.Column="2" Margin="0,8,3,2"
                             Style="{StaticResource PropertyTextBoxStyle}" Text="1"
                             TextChanged="OnUvChanged"/>
                    <TextBlock Grid.Row="8" Grid.Column="3" Text="UV" FontSize="10"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="{loc:Loc material_editor.uv_offset}"
                               Style="{StaticResource PropertyLabelStyle}" Margin="0,8,0,0"/>
                    <TextBox x:Name="UvOffsetU" Grid.Row="9" Grid.Column="1" Margin="0,8,3,2"
                             Style="{StaticResource PropertyTextBoxStyle}" Text="0"
                             TextChanged="OnUvChanged"/>
                    <TextBox x:Name="UvOffsetV" Grid.Row="9" Grid.Column="2" Margin="0,8,3,2"
                             Style="{StaticResource PropertyTextBoxStyle}" Text="0"
                             TextChanged="OnUvChanged"/>
                    <TextBlock Grid.Row="9" Grid.Column="3" Text="UV" FontSize="10"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                </Grid>

                <!-- ══ 杂项 ══ -->
                <CheckBox x:Name="TwoSidedCheck" Content="{loc:Loc material_editor.two_sided}"
                          FontSize="11.5" Margin="0,2,0,6"
                          Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                          Checked="OnFlagChanged" Unchecked="OnFlagChanged"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:Loc material_editor.blend_mode}"
                               Style="{StaticResource PropertyLabelStyle}"/>
                    <ComboBox x:Name="BlendCombo" Grid.Column="1" FontSize="11" Padding="6,2"
                              Margin="8,0,0,0" SelectionChanged="OnBlendChanged"/>
                </Grid>

                <!-- ══ 贴图 ══ -->
                <TextBlock Text="{loc:Loc material_editor.maps}"
                           Style="{StaticResource InspectorSectionHeaderStyle}" Margin="0,8,0,0"/>
                <StackPanel x:Name="MapFields"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="{loc:Loc material_editor.load}" MinWidth="96" MinHeight="28"
                    FontSize="11.5" Margin="0,0,8,0"
                    Click="OnLoadMaterialClick"/>
            <Button Content="{loc:Loc common.close}" MinWidth="84" MinHeight="28" FontSize="11.5"
                    Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
