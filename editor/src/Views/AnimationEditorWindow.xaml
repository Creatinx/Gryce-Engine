<Window x:Class="GryceEngine.Editor.Views.AnimationEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GryceEngine.Editor.Markup"
        Title="{loc:Loc animation_editor.title}"
        Width="980" Height="640"
        MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{loc:Loc animation_editor.title}"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="EntityLabel" Grid.Column="1"
                       FontSize="11.5" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" Content="{loc:Loc animation_editor.refresh}"
                    Style="{StaticResource ToolbarButtonStyle}" Width="Auto" MinWidth="64"
                    Padding="10,2" Margin="0,0,6,0" Click="OnRefreshClick"/>
            <Button Grid.Column="3" Content="{loc:Loc animation_editor.export}"
                    Style="{StaticResource ToolbarButtonStyle}" Width="Auto" MinWidth="96"
                    Padding="10,2" Click="OnExportClick"/>
        </Grid>

        <!-- ══ Body ══ -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Clip list -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{loc:Loc animation_editor.clips}"
                               Style="{StaticResource PanelHeaderTextStyle}"
                               Margin="0,0,0,6"/>
                    <ListBox x:Name="ClipList"
                             Background="Transparent" BorderThickness="0"
                             SelectionChanged="OnClipSelected">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               FontSize="11.5"/>
                                    <TextBlock Text="{Binding Duration, StringFormat='  {0:0.00}s'}"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               FontSize="10.5"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoClipsText"
                               Text="{loc:Loc animation_editor.no_clips}"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               TextWrapping="Wrap"/>
                </DockPanel>
            </Border>

            <!-- Right: playback + skeleton + keyframes -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Playback controls -->
                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PlayPauseButton" Grid.Column="0"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Width="34" Height="26" Margin="0,0,4,0"
                                FontFamily="Segoe MDL2 Assets" Content="&#xE768;"
                                ToolTip="{loc:Loc animation_editor.play}"
                                Click="OnPlayPauseClick"/>
                        <Button x:Name="StopButton" Grid.Column="1"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Width="34" Height="26"
                                FontFamily="Segoe MDL2 Assets" Content="&#xE71A;"
                                ToolTip="{loc:Loc animation_editor.stop}"
                                Click="OnStopClick"/>
                        <CheckBox x:Name="LoopCheck" Grid.Column="2"
                                  Content="{loc:Loc animation_editor.loop}"
                                  FontSize="11" VerticalAlignment="Center"
                                  Margin="14,0,0,0"
                                  Checked="OnLoopChanged" Unchecked="OnLoopChanged"/>
                        <TextBlock Grid.Column="3" Text="{loc:Loc animation_editor.speed}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="16,0,6,0"/>
                        <Slider x:Name="SpeedSlider" Grid.Column="4"
                                Width="110" Minimum="0" Maximum="4"
                                VerticalAlignment="Center"
                                ValueChanged="OnSpeedChanged"/>
                        <TextBlock x:Name="SpeedLabel" Grid.Column="5"
                                   Text="1.00x" FontSize="10.5" FontFamily="Consolas"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <StackPanel Grid.Column="6" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc animation_editor.time}"
                                       FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Margin="0,0,6,0"/>
                            <Slider x:Name="TimeSlider" Width="240" Minimum="0" Maximum="10"
                                    VerticalAlignment="Center"
                                    ValueChanged="OnTimeChanged"/>
                            <TextBlock x:Name="TimeLabel" Text="0.00s / 0.00s"
                                       FontSize="10.5" FontFamily="Consolas"
                                       VerticalAlignment="Center" Margin="6,0,0,0"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Skeleton + keyframe data -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.25*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{loc:Loc animation_editor.skeleton}"
                                       Style="{StaticResource PanelHeaderTextStyle}"
                                       Margin="0,0,0,6"/>
                            <TreeView x:Name="BoneTree"
                                      Background="Transparent" BorderThickness="0"/>
                            <TextBlock x:Name="NoSkeletonText"
                                       Text="{loc:Loc animation_editor.no_skeleton}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="10,0,0,0"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="{loc:Loc animation_editor.keyframes}"
                                       Style="{StaticResource PanelHeaderTextStyle}"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="TrackCombo" DockPanel.Dock="Top"
                                      FontSize="10.5" Margin="0,0,0,6"
                                      SelectionChanged="OnTrackSelected">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding BoneName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding TrackInfo}"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <DataGrid x:Name="KeyframeGrid"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      RowHeaderWidth="0"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      FontSize="10.5"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                      RowBackground="Transparent"
                                      AlternatingRowBackground="#0AFFFFFF"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ch" Binding="{Binding Channel}" Width="46"/>
                                    <DataGridTextColumn Header="# " Binding="{Binding KeyIndex}" Width="30"/>
                                    <DataGridTextColumn Header="t" Binding="{Binding Time, StringFormat={}{0:0.000}}" Width="60"/>
                                    <DataGridTextColumn Header="X" Binding="{Binding X, StringFormat={}{0:0.###}}" Width="60"/>
                                    <DataGridTextColumn Header="Y" Binding="{Binding Y, StringFormat={}{0:0.###}}" Width="60"/>
                                    <DataGridTextColumn Header="Z" Binding="{Binding Z, StringFormat={}{0:0.###}}" Width="60"/>
                                    <DataGridTextColumn Header="W" Binding="{Binding W, StringFormat={}{0:0.###}}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="NoKeyframeText"
                                       Text="{loc:Loc animation_editor.no_selection}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
