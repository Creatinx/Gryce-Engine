<Window x:Class="GryceEngine.Editor.Views.TilemapEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GryceEngine.Editor.Markup"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{loc:Loc tilemap_editor.title}"
        Width="720" SizeToContent="Height"
        MinWidth="560" MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tileset path -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{loc:Loc tilemap_editor.tileset}" VerticalAlignment="Center"
                       Margin="0,0,8,0" FontSize="12"/>
            <TextBox Grid.Column="1" x:Name="TilesetBox" FontSize="12" Padding="4,3"/>
            <Button Grid.Column="2" Content="{loc:Loc common.browse}" Margin="8,0,0,0"
                    Padding="14,5" Click="OnBrowseTilesetClick"/>
        </Grid>

        <!-- Map / cell size -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{loc:Loc tilemap_editor.map_size}" VerticalAlignment="Center"
                       FontSize="12" Margin="0,0,6,0"/>
            <TextBlock Text="{loc:Loc tilemap_editor.width}" VerticalAlignment="Center"
                       FontSize="11" Margin="0,0,3,0"/>
            <TextBox x:Name="WidthBox" Width="52" FontSize="12" Padding="3,2"/>
            <TextBlock Text="{loc:Loc tilemap_editor.height}" VerticalAlignment="Center"
                       FontSize="11" Margin="10,0,3,0"/>
            <TextBox x:Name="HeightBox" Width="52" FontSize="12" Padding="3,2"/>
            <TextBlock Text="{loc:Loc tilemap_editor.cell_size}" VerticalAlignment="Center"
                       FontSize="11" Margin="14,0,3,0"/>
            <TextBox x:Name="CellWBox" Width="52" FontSize="12" Padding="3,2"/>
            <TextBlock Text="×" VerticalAlignment="Center" Margin="4,0"/>
            <TextBox x:Name="CellHBox" Width="52" FontSize="12" Padding="3,2"/>
            <Button Content="{loc:Loc tilemap_editor.apply_size}" Margin="12,0,0,0"
                    Padding="12,5" Click="OnApplySizeClick"/>
        </StackPanel>

        <!-- Palette -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{loc:Loc tilemap_editor.palette}" VerticalAlignment="Center"
                       FontSize="12" Margin="0,0,8,0"/>
            <ItemsControl x:Name="PalettePanel">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <TextBlock x:Name="PaletteHint" VerticalAlignment="Center" FontSize="10.5"
                       Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
        </StackPanel>

        <!-- Grid painter -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" Padding="6" MinHeight="180"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="TileGrid"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{loc:Loc tilemap_editor.apply}" Padding="18,6"
                    Click="OnApplyClick"/>
            <Button Content="{loc:Loc tilemap_editor.close}" Padding="18,6"
                    Margin="10,0,0,0" Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>
