<Window x:Class="GryceEngine.Editor.Views.AddComponentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:GryceEngine.Editor.Markup"
        xmlns:views="clr-namespace:GryceEngine.Editor.Views"
        xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
        ui:ThemeManager.IsThemeAware="True"
        ui:WindowHelper.UseModernWindowStyle="True"
        Title="{loc:Loc inspector.add_component}"
        Width="460" Height="460"
        MinWidth="360" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                       FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       VerticalAlignment="Center" Margin="4,0,8,0"/>
            <TextBox x:Name="SearchBox" Grid.Column="1"
                     FontSize="12" Padding="8,5"
                     TextChanged="OnSearchTextChanged"
                     KeyDown="OnSearchKeyDown"/>
        </Grid>

        <!-- Category tree (parent = category, child = component type) -->
        <TreeView x:Name="TypeTree" Grid.Row="1" Margin="0,10,0,0"
                  BorderThickness="0" Background="Transparent"
                  FontSize="12"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="OnTypeTreeDoubleClick"
                  SelectedItemChanged="OnTypeSelectionChanged">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="Padding" Value="4,3"/>
                    <Setter Property="MinHeight" Value="24"/>
                    <Setter Property="IsExpanded" Value="True"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <!-- Category header -->
                <HierarchicalDataTemplate DataType="{x:Type views:ComponentCategory}"
                                          ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>
                <!-- Component leaf -->
                <DataTemplate DataType="{x:Type views:ComponentTypeEntry}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Icon}"
                                   FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{Binding IconColor}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>

        <!-- Description -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10,7" CornerRadius="6"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" MinHeight="36">
            <TextBlock x:Name="DescriptionText"
                       Text="{loc:Loc create_entity.no_selection}"
                       FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{loc:Loc create_entity.cancel}"
                    MinWidth="88" MinHeight="30" FontSize="12"
                    Margin="0,0,8,0" Click="OnCancelClick" IsCancel="True"/>
            <Button x:Name="AddButton" Content="{loc:Loc inspector.add_component}"
                    MinWidth="110" MinHeight="30" FontSize="12"
                    Style="{StaticResource AccentButtonStyle}"
                    IsDefault="True" Click="OnAddClick"/>
        </StackPanel>
    </Grid>
</Window>
