{
  "name": "light",
  "description": "亮色轻盈风",
  "bgm": {
    "bpm": 128,
    "style": "minimal_electronic",
    "kick_intensity": 0.5,
    "bass_intensity": 0.2
  },
  "layout": {
    "width": 1920,
    "height": 1080,
    "background": "#F5F5F7",
    "padding_x": 120,
    "padding_y": 100
  },
  "fonts": {
    "title": {
      "family": "Inter-Bold",
      "size": 96,
      "color": "#1D1D1F"
    },
    "subtitle": {
      "family": "Inter-Regular",
      "size": 28,
      "color": "#6E6E73"
    },
    "heading": {
      "family": "Inter-Bold",
      "size": 64,
      "color": "#1D1D1F"
    },
    "body": {
      "family": "Inter-Regular",
      "size": 20,
      "color": "#424245"
    },
    "label": {
      "family": "JetBrainsMono-Regular",
      "size": 12,
      "color": "#86868B",
      "letter_spacing": 2
    },
    "mono": {
      "family": "JetBrainsMono-Regular",
      "size": 14,
      "color": "#86868B"
    },
    "tag": {
      "family": "JetBrainsMono-Regular",
      "size": 12,
      "color": "#86868B",
      "letter_spacing": 1
    }
  },
  "cursor": {
    "color": "#1D1D1F",
    "width": 3,
    "blink": true,
    "blink_interval": 0.8
  },
  "card": {
    "background": "#FFFFFF",
    "border_color": "#E5E5E5",
    "border_width": 1,
    "border_radius": 16,
    "padding": 32,
    "shadow": true,
    "accent_line": {
      "enabled": true,
      "color": "#0066CC",
      "width": 3,
      "position": "left"
    }
  },
  "pill": {
    "background": "#FFFFFF",
    "border_color": "#E5E5E5",
    "border_radius": 8,
    "padding_x": 18,
    "padding_y": 10,
    "text_color": "#424245",
    "font_size": 15
  },
  "mono_box": {
    "background": "#FFFFFF",
    "border_color": "#E5E5E5",
    "border_radius": 8,
    "padding_x": 16,
    "padding_y": 10,
    "left_border": {
      "enabled": true,
      "color": "#0066CC",
      "width": 2
    }
  },
  "button": {
    "background": "#FFFFFF",
    "border_color": "#D2D2D7",
    "border_radius": 10,
    "padding_x": 24,
    "padding_y": 14,
    "text_color": "#1D1D1F",
    "subtext_color": "#86868B",
    "font_size": 16,
    "subfont_size": 13
  },
  "list": {
    "bullet": "▪",
    "bullet_color": "#0066CC",
    "text_color": "#424245",
    "strong_color": "#1D1D1F",
    "font_size": 18,
    "line_height": 2.2,
    "indent": 24
  },
  "transition": "fade",
  "fade_duration": 0.3
}